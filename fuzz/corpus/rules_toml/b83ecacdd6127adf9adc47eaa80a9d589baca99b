# SysScope default detection rules (plan section 5). Embedded in the daemon;
# /etc/sysscope/rules.toml may override any value. Wording lives here so it can
# change without code. Thresholds are guarded by scripts/check-integrity.sh:
# changing one needs a "Deviations from the plan" entry in PROGRESS.md.
version = 1

[score]
half_life_s = 600.0
suspicious_at = 30
high_at = 60
max_evidence_events = 10

[rules.R001]
title = "Credential file read"
attack = "T1552"
weight = 0.6
confidence_untrusted_exe = 0.9
confidence_system_exe = 0.5
why = [
  "this file holds {subject_desc}",
  "the program is not on the allowlist for {subject}",
]
benign = ["you ran a backup, sync or key-management tool yourself"]

[rules.R002]
title = "Execution from a writable temp location"
attack = "T1204"
weight = 0.4
confidence = 1.0
dirs = ["/tmp/", "/var/tmp/", "/dev/shm/", "/run/user/"]
why = ["the program was started from {dir}, a directory any program can write to"]
benign = ["an installer or build tool you ran unpacks and runs helpers from a temp directory"]

[rules.R003]
title = "Fileless execution"
attack = "T1620"
weight = 0e = 0.6
consecutive_s = 3
why = ["the program produced events faster than the tracer's per-process budget for {consecutive_s} seconds, so some of th equals `exe` (a "*"
# is allowed in the last path component only) AND the daemon verified that the
# executable is owned by root and neither it nor its directory is group- or
# world-writable. `subject = "*"` matches every subject of the rule.

[[allow]]
rule = "R001"
exe = "/usr/sbin/sshd"
subject = "ssh_keys"
reason = "the SSH server reads host and user keys"

[[allow]]
rule = "R001"
exe = "/usr/bin may override any value. Wording lives here so it can
