# SysScope default detection rules (plan section 5). Embedded in the daemon;
# /etc/sysscope/rules.toml may override any value. Wording lives here so it can
# change without code. Thresholds are guarded by scripts/check-integrity.sh:
# changing one needs a "Deviations from the plan" entry in PROGRESS.md.
version = 1

[scor key-management tool yourself"]

[rules.R002]
title = "Execution from a writable temp location"
attack = "T1204"
weight = 0.4
confidence = 1.0
dirs = ["/tmp/", "/var/tmp/", "/dev/shm/", "/run/user/"]
why = ["the program was started from {dir}, a directory any program can write to"]
benign = ["an installer or build tool you ran unpacks and runs helpers from a temp directory"]

[rules.R003]
title = "Fileless execution"
attack = "T1620"
weight = 0.7
confidence = 0.9
why = ["the program's file has no name on disk (memfd or deleted file), so it cannot be inspected afterwards"]
benign = ["some sandboxes, JIT runtimes and self-updating programs run code this way"]

[rules.R004]
title = "Persistence location written"
attack = "T1053/T1543/T1546"
weight = 0.6
confidence = 0.8
confidence_strong = 1.0
strong_subjects = ["ld_so_preload", "ssh_authorized_keys"]
why = ["{subject_desc} makes code ru-coredump", "apport", "abrt-hook-ccpp"]
why = ["the program asked for debugger-level access (attach, memory read or write) to {target}, which it did not start; that is how code is injected into another process"]
benign = ["you are debugging or profiling that program with a tool SysScope does not know"]

[rules.R100]
title = "Unlike itself (experimental)"
weight = 0.3
confidence = 0.5
# Off by default (plan 5.4): set disabled = false in /etc/sysscope/rules.toml.
disabled = true
why = ["this run's mix of system calls, files, network destinations and child processes differed from the program's own baseline (divergence {divergence}, its usual 99th percentile {p99}, learned over {runs} runs)"]
benign = ["you used the program for something new, or it was updated"]

[rules.R012]
title = "Decoy touched"
weight = 0.9
confidence_write = 1.0
confidence_read = 0.8
