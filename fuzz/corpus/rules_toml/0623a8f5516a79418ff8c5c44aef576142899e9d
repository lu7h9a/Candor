# SysScope default allowlist (plan 5.3). /etc/sysscope/allow.toml adds entries.
# An entry matches only if the process's executable path equals `exe` (a "*"
# is allowed in the last path componow]]
rule = "R001"
exe = "/usr/bin/passwd"
subject = "shadow"
reason = "passwd changes passwords"

[[allow]]
rule = "R001"
exe = "/usr/lib/polkit-1/polkit-agent-helper-1"
subject = "shadow"
reason = "polkit checks passwords for admin prompts"

[[allow]]
rule = "R001"
exe = "/usr/sbin/unix_chkpwd"
subject = "shadow"
reason = "PAM helper that checks passwords for screen lockers"

[[allow]]
rule = "R001"
exe = "/opt/google/chrome/chrome"
subject = "browser_creds"
reason = "the browser reads its own saved passwords"

[[allow]]
rule = "R001"
exe = "/usr/lib/chromium/chromium"
subject = "browser_creds"
reason = "the browser reads its own saved passwords"

[[allow]]
rule = "R001"
exe = "/opt/brave.com/brave/brave"
subject = "browser_creds"
reason = "the browser reads its own saved passwords"

[[allow]]
rule = "R001"
exe = "/usr/lib/firefox/firefox"
subject = "browser_creds"
reason = "the browser reads its own saved passwords"

[[allow]]
rule = "R001"
exe = "/usr/lib/firefox-esr/firefox-esr"
subject = "browser_creds"
reason = "the browser reads its own saved passwords"

[[allow]]
rule = "R004"
exe = "/usr/sbin/cron"
subject = "cron"
reason = "cron manages its own schedules"

[[allow]]
rule = "R004"
exe = "/usr/bin/crontab"
subject = "cron"
reason = "crontab edits schedules on request"

[[allow]]
rule = "R004"
exe = "/usr/lib/systemd/systemd"
subject = "systemd_units"
reason = "systemd manages its unit files"

[[allow]]
rule = "R004"
exe = "/usr/bin/systemctl"
subject = "systemd_units"
reason = "systemctl enables and edits units on request"

[[allow]]
rule = "R004"
exe = "/usr/bin/dpkg"
subject = "cron"
reason = "the package manager installs system files (packages ship these; never the preload list, authorized_keys or a user's autostart)"

[[allow]]
rule = "R004"
exe = "/usr/bin/dpkg"
subject = "systemd_units"
reason = "the package manager installs system files (packages ship these; nevervice manager starts login sessions through PAM, which checks the account in /etc/shadow (seen for every SSH login)"

[[allow]]
rule = "R001"
exe = "/usr/bin/perl"
script = "/usr/sbin/dpkg-preconfigure"
subject = "shadow"
reason = "debconf's pre-install step, run by apt before every install, reads the account database"

[[allow]]
rule = "R006"
exe = "/usr/lib/chromium/chromium"
subject = "*"
reason = "browsers and mail clients poll update, connectivity and sync endpoints at fixed intervals (seen in the benign corpus: Chromium every ~297 s while idle)"

