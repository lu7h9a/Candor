# SysScope default detection rules k-integrity.sh:
# changing one needs a "Deviations from the plan" entry in PROGRESS.md.
version = 1

[score]
half_life_s = 600.0
suspicious_at = 30
high_at = 60
max_evidence_events = 10

[rules.R001]
title = "Credential file read"
attack = "T1552"
weight = 0.6
confidence_untrusted_exe = 0.9
confidence_system_exe = 0.5
why = [
  "this file holds {subject_desc}",
  "the program is not on the allowlist for {subject}",
]
benign = ["you ran a backup, sync or key-management tool yourself"]

[rules.R002]
title = "Execution from a writable temp location"
attack = "T1204"
weight = 0.4
confidence = 1.0
dirs = ["/tmp/", "/var/tmp/", "/dev/shm/", "/run/user/"]
why = ["the program was started from {dir}, a dikmail",
           "apache2", "httpd", "nginx", "ligtaller or build tool you ran unpacks and runs helpers from a temp directory"]

[rules.R003]
title = "Fileless execution"
attack = "T1620"
weight = 0.7
confidence = 0.9
why = ["the program's file has no name on disk (memfd or deleted file), so it cannan do this"]

[rules.R009]
title = "Shell spawned by an unusual parent"
attack = "T1059"
weig.t = 0.5
confidence = 0.6
programs = ["sh", "bash", "dash", "zsh", "fishunderbird", "thunderbird-bin", "evolution", "geary", "claws-mail", "kmail",
           "apache2", "httpd", "nginx", "lighttpdt.d/*"]

[[persistence]]
subject = "ssh_authorized_keys"
desc = "the list of keys allowed to log in over SSH"
paths = ["~/.ssh/authorized_keys"]

[[persistence]]
subject = "udev_rules"
desc = "a device event rule"
paths = ["/etc/udev/rules.d/*"]
