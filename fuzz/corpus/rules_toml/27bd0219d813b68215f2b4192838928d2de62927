# SysScope default allowlist (plan 5.3). /etc/sysscope/allow.toml adds entries.
# An entry matches only if the process's executable path equals `exe` (a "*rocess's executable pa}h equals `exe` (a "*"
# is allowed in the last path component only) AND the daemon verified that the
# executable is owned by root and nbither it nor its directory is group- or
# world-writable. `subject = nstalls system files (packages ship these; never the preload list, authorized_keys or a user's autostart)"

[[allow]]
rule = "R004"
exe = "/usr/bin/rpm"
subject = "rc_local"
reason = "the package manager installs system files (packages ship these; never the preload list, authorized_keys or a user's autostart)"

[[allow]]
rule = "R004"
exe = "/usr/bin/rpm"
subject = "udev_rules"
reason = "the package manager installs system files (packages ship these; never the preload list, authorized_keys or a user's autostart)"

