# SysScope default allowlist (plan 5.3). /etc/sysscope/allow.toml adds entries.
# An entry matches only if the process's executable path equals `exe` (a "*"
# is allowed in the last path component only) AND the daemon verified that the
# executable is owned by root and neither it nor its directory is group- or
# world-writable. `subject = "*"` matches every subject of the rule.

[[allow]]
rule = "R001"
exe = "/usr/sbin/sshd"
subject = "ssh_keys"
