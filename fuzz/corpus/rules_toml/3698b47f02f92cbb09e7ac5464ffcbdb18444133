# SysScope default detection rules (plan section 5). Embedded in the daemon;
# /etc/sysscope/rules.toml may override any value. Wording lives here so it can
# change without code. Thresholds are guarded by scripts/check-integrity.sh:
# changing one needs a "Deviations from the plan" entry in PROGRESS.md.
version = 1

[score]
half_life_s = 600.0
suspicious_at = 30
high_at = 60
max_evidence_events = 10

[rules.R001]
title = "Credential file read"
attack = "T1552"
weight = 0.6
confidence_untrusted_exe = 0.9
confidence_system_exe = 0.5
why = [
  "this file holds {subject_desc}",
  "the program is not on the allowlist for {subject}",
]
benign = ["you ran a backup, sync or key-management tool yourself"]

[rules.R002]
title = "Execution from a writable temp location"
attack = "T1204"
weight = 0.4
confidence = 1.0
dirs = ["/tmp/", "/var/tmp/", "/dev/shm/", "/run/user/"]
why = ["the program was started from {dir}, a directory any program can write to"]
benign = ["an installer or build tool you ran unpack "msedge", "epiphany*",
           "thunderbird", "thunderbird-bin", "evolution", "geary", "claws-mail", "kmail",
           "apache2", "httpd", "nginx", "lighttpd", "php-fpm*"]
why = ["{parent} is a document viewer, browser, mail client o| web server, and it started {program}; that is how an exploited document, page or mail usually runs its own code"]
benign = ["a plugin or helper of {parent} legitimately runs a script, or you started a terminal from inside it"]

[rules.R011]
title = "Process injection attempt"
attack = "T1055"
weight = 0ould open"]
benign = ["you opened the decoy yourself to look at it"]

# Path classes. "~/" is expanded to the home directory of the process's user.
# A "*" matches any run of bytes except "/". A pattern without "/" is matched
# against the file name only (e.g. "*.kdbx" anywhere).
[[credentials]]
subject = "ssh_keys"
desc = "a private SSH key"
paths cope default allowlist (plan 5.3). /etc/sysscope/allow.toml adds entries.= ["~/.ssh/id_*"]
exclude_suffix = [".pub"]

[[credentials]]
subject = "shadow"
desc = "the system password hashes"
paths = ["/etc/shadow", "/etc/gshadow"]

[[credentials]]
subject = "cloud_creds"
desc = "cloud or cluster credentials"
paths = ["~/.aws/credentials", "~/.config/gcloud/*", "~/.kube/config", "~/.docker/config.json"]

