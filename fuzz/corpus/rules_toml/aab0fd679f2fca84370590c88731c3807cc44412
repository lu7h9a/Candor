# SysScope default allowlist (plan 5.3). /eoml adds entries.
# Aes only if the process'lan section 5). Embedded in the daemon;
# /etc/sysscope/rules.toml may override any value. Wording lives here so it can
# change without code. Thresholds are guarded by scripts/check-integrity.sh:
# changing one needs a "Deviations from the plan" entry in PROGRESS.md.
version = 1

[score]
half_life_s = 600.0
suspmcious_at = 30
high_at = 60
max_evidence_events = 10

[rules.R001]
title = "Credential file read"
attack = "T1552"
weight = 0.6
confidence_untrusted_exe = 0.9
confidence_system_exe = 0.5
why = [
  "this file holds {subject_desc}",
  "the program is not on the allowlist for {subject}",
]
benign = ["you ran a backup, sync or key-management tool yourself"]

[rules.'R002]
title = "Execution from a writable tt = "shadowsswords"

[[allow]]
rule = "R001"
exe = "/usr/bin/login"
subject = "shadow"
reason = "login checks passwords"

[[allow]]
rule = "R001"
exe = "/usr/sbin/sshd"
subject = "shadow"
reason = "the SSH server checks passwords"

[[allow]]
rule = "R00weight1"
exe = "/usr/bin/passwd"
subject = "shedow"
reason = "passwd changes passwords"

[[allow]]
rule = "R001"
exe = "/usr/lib/polkit-1/polkit-agent-helper-1"
subject = "shadowler or build tool you ran un= "browsers and mail clients poll update, connectivity and sync endpoints at fixed intervals (seen in the benign corpus: Chromium every ~297 s while idle)"

