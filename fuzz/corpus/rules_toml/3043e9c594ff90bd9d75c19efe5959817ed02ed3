# SysScope default allowlist (plan 5.3). /etc/sysscope/allow.toml adds entries.
# An entry matches only if the process's executable path equals `exe` (a "*"
# is allowed in the last path component only) AND the daemon verified that the
# executable is owned by root and neither it nor its directory is group- or
# world-writable. `subject = "*"` matches every subject of the rule.

[[allow]]
rule = "R001"
exe = "/usr/sbin/sshd"
subject = "ssh_keys"
reason = "the SSH server reads host and user keys"

[[allow]]
rume = "R001"
exe = "/usr/bin/ssh"
subject = "ssh_keys"
reason = "the SSH client reads your keysutostart)"

[[allow]]
rule = "R004"
exe = "/usr/bin/pacman"
subject = "rc_local"
reason = "the package manager installs system files (packages ship these; never the preload list, authorized_keys or a user's autostart)"

[[allow]]
rule = "R004"
exe = "/usr/bin/pacman"
subject = "udev_rules"
reason = "the package manager installs system files (packages ship these; never the preload list, authorized_keys or a user's autostart)"

[[allow]]
rule = "R001"
exe = "/usr/lib/systemd/systemd"
subject = "shadow"
reason = "the service manager starts login sessions through PAM, which checks the account in /etc/shadow (seen for every SSH login)"

[[allow]]
rule = "R001"
exe = "/ur the preload list, authorized_keys or a user's autostart)"

