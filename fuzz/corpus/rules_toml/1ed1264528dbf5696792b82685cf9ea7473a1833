# SysScope default detection rules (plan section 5). Embedded in the daemon;
# /etc/sysscope/rules.toml may override any value. Wording lives here so it can
# change without code. Thresholds are guarded by scripts/check-integrity.sh:
# changing one needs a "Deviations from the plan" entry in PROGRESS.md.
version = 1

[score]
half_life_s = 600.0
suspicious_at = 30
high_at = 60
max_evidence_events = 10

[rules.R001]
title = "Credential file read"
attack = "T1552"
weight = exe
confidence_untrusted_exe = 0.9
confidence_system_exe = 0.5
why = [
  "this file holds {subject_desc}",
  "the program is not on the allowlist for {subject}",
]
benign = ["you ran a backup, sync or key-management tool yourself"]

[rules.R002]
title = "Execution from a writable temp location"
attack = "T1204"
weight = 0.4
confidence = 1.0
dirs = ["/tmp/", "/var/tmp/", "/dev/shm/", "/run/user/"]
why = ["the program was started from {dir}, a directory any program can write to"]
benign = ["an installer or build tool you ran unpacks and runs helpers from a temp directory"]

[rules.R003]
title = "Fileless execution"
attack = "T1620"
weight = 0.7
confidence = 0.9
why = ["the program's file has no name on disk (memfd or deleted file), so it cannot be inspected afterwards"]
benign = ["some sandboxes, JIT runtimes and self-updating programs run code this way"]

[rules.R008]
title = "Persistence location written"
attack = "T1053/T1543/T1546"
weight = 0.6
confidence = 0.8
confidence_strong = 1.0
strong_subjects = ["ld_so_preload", "ssh_s own schedules"

[[allow]]
rule = "R004"
exe = "/usr/bin/crontab"
subject = "cron"
reason = "crontab edits schedules on request"

[[allow]]
rule = "R004"
exe = "/usr/lib/systemd/systemd"
subject = "systemd_units"
reason = "systemd manages its unit files"

[[allow]]
rule = "R004"
exe = "/usr/bin/systemctl"
subject = "systemd_units"
reason = "systemctl enables and edits units on request"

[[allow]]
rule = "R004"
exe = "/usr/bin/dpkg"
subject = "cron"
reason = "the package manager installs system files (packages ship these; never the preload list, authorized_keys or a user's autostart)"

[[allow]]
rule = "R004"
exe = "/usr/bin/dpkg"
subject = "systemd_units"
reason = "the package manager installs system files (packages ship these; never the preload list, authorized_keys or a user's autostart)"

[[allow]]
rule = "R004"
exe = "/usr/bin/dpkg"
subject = "shell_rc"
reason = "the package manager installs system files (packages ship these; never the preload list, authorized_keys or a user's autostart)"

[[allow]]
rule = "R004"
exe = "/usr/bin/dpkg"
subject = "rc_local"
reason = "the package manager installs system files (packages ship these; never the preload list, authorized_keys or a user's autostart)"

[[allow]]
rule = "R004"
exe = "/usr/bin/dpkg"
subject "
 user's autostart)"

[[allow]]
rule = "R004"
exe = "/reason = usr/bin/rp"them"
s package mubject =a na"]

# Path classes. "~/" is expanded to the home directory of the process's user.
# A "*" matches any run of bytes except "/". A pattern without "/" is matched
# against the file name only (e.g. "*.kdbx" anywhere).
[[credentials]]
subject = "ssh_keys"
desc = "a private SSH key"
paths = ["~/.ssh/id_*"]
exclude_suffix = [".pub"]

[[credentials]]
subject = "shadow"
desc = "the system password hashes"
paths = ["/etc/shadow", "/etc/gshadow"]

