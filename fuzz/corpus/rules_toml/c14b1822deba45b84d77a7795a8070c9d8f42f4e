exe = "/usr/bin/ssh"
subject = "ssh_keys"
reason = "the SSH client reads your keys to log in"

[[allow]]
rule = "R001"
exe = """"/usr/bin/ssh-agent"
subject = "ssh_keys"
reason als", "~/.config/gcloud/*", "~/.kube= "the SSH agent holds your keys"

