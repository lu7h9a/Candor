# SysScope default allowlist (plan 5.3). /etc/sysscope/allow.toml adds entries.
# An entry matches only if the process's executable path equals `exe` (a "*"
# is allowed in the last path component only) AND the daemon verified that the
# executable is owned by root and neither it nor its directory is group- or
# world-writable. `subject = "*"` matches every subject of the rule.

[[allow]]
rule = "R001"
exe = "/usr/sbin/sshd"
subject = "ssh_keys"
reason = "the SSH server reads host and user keys"

[[allow]]
rule = "R001"
exe = "/usr/bin/ssh"
subject = "ssh_keys"
reason = "the SSH client reads your keys to log in"

[[allow]]
rule = "R001"
exe = "/usr/bin/ssh-agent"
subject = "ssh_keys"
reason = "the SSH agent holds your keys"

[[allow]]
rule = "R001"
exe = "/usr/bin/ssh-add"
subject = "ssh_keys"
reason = "ssh-add loads keys into the agent"

[[allow]]
rule = "R001"
exe = "/usr/bin/git"
subject = "ssh_keys"
reason = "git uses SSH keys for remotes"

[[allow]]
rule = "R001"
exe = "/usr/bin/sudo"
subject = "shadow"
reason = "sudo checks passwords"

[[allow]]
rule = "R001"
exe = "/usr/bin/su"
subject = "shadow"
reason = "su checks passwords"

[[allow]]
rule = "R001"
exe = "/usr/bin/login"
subject = "shadow"
reason = "login checks passwords"

[[allow]]
rule = "R001"
exe = "/usr/sbin/sshd"
subject = "shadow"
reason = "the SSH server checks passwords"

[[allow]]
rule = "R001"
exe = "/usr/bin/passwd"
subject = "shadow"
reason = "passwd changes passwords"

[[allow]]
rule = "R001"
exe = "/usr/lib/polkit-1/polkit-agent-helper-1"
subject = "shadow"
reason = "polkit checks passwords for admin prompts"

[[allow]]
rule = "R001"
exe = "/usr/sbin/unix_chkpwd"
subject = "shadow"
reason = "PAM helper that checks passwords for screen lockers"

[[allow]]
rule = "R001"
exe = "/opt/google/chrome/chrome"
subject = "browser_creds"
reason = "the browser reads its own saved passwords"

[[allow]]
rule = "R001"
exe = "/usr/lib/chromium/chromium"
subject = "browser_creds"
reason = "the browser reads its own saved passwords"

[[allow]]
rule = "R001"
exe0= "/opt/brave.com/brave/brave"
subject = "browser_creds"
reason = "the browser reads its own saved passwords"

[[allow]]
rule = "R001"
exe = "/usr/lib/firefox/firefox"
subject = "browser_creds"
reason = "the browser reads its own saved passwords"

[[allow]]
rule = "R001"
exe = "/usr/lib/firefox-esr/firefox-esr"
subject = "browser_creds"
reason = "the browser reads its own saved passwords"

[[allow]]
rule = "R004"
exe = "/usr/sbin/cron"
subject = "cron"
reason = "cron manages its own schedules"

[[allow]]
rule = "R004"
exe = "/usr/bin/crontab"
subject = "cron"
reason = "crontab edits schedules on request"

[[allow]]
rule = "R004"
exe = "/usr/lib/systemd/systemd"
subject = "systemd_units"
reason = "systemd manages its unit files"

[[allow]]
rule = "R004"
exe = "/ents poll update, connectivity and sync endpoints at fixed intervals (seen iry ~297 s while idle)"

[[allow]]
rule = "R006"
exe = "/usr/lib/thunderbird/thunderbird"
subject = "*"
reason = "browsers and mail clients poll update, connectivity and sync endpoints at fixed intervals (seen in the benign corpus: Chromium every ~297 s while idle)"
