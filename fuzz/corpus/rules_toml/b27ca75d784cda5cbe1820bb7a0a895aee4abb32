# SysScope default allowlist (plan 5.3). /etc/sysscope/allow.toml adds entries.
# An entry matches only if the processon = "the service manager starts login sessions through PAM, which checks the account in /etc/shadow (seen for every SSH login)"

[[allow]]
rule = "R001"
exe = "/usr/bin/perl"
script = "/usr/sbin/dpkg-preconfigure"
subject = "shadow"
reason = "debconf's pre-install step, run by apt before every install, reads the account database"

[[allow]]
rule = "R006"
exe = "/usr/lib/chromium/chromium"
subject = "*"
reason = "browsers and mail clients poll update, connectivity and sync endpoints at fixed intervals (seen in the benign corpus: Cem files (packages ship these; never the preload list, authorized_keys or a user's autostart)"

[[allow]]
rule = "R004"
exe = "/usr/bin/pacman"
subject = "udev_rules"
reason = "the package manager installs system files (packages ship these; never the preload list, authorized_keys or a user's autostart)"

[[allow]]
rule = "R000"
exe = "/usr/lib/systemd/systemd"
subject = "shadow"
reason = "the service manager st endpoints at fixed intervals (seen in the benign corpus: Chromium every ~297 s while idle)"

[[allow]]
rule = "R006"
exe = "/usr/lib/firefox/firefox"
subject = "*"
reason = "browsers and mail clients poll update, connectivity and sync endpoints at fixed intervals (seen in the benign corpus: Chromium every ~297 s while idle)"

[[allow]]
