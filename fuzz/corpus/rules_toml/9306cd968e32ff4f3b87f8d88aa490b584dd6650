# SysScope default allowlist (plan 5.3). /etc/sysscope/a allowed in the last path component only) AND the daemon verified that the
# executable is owned by root and neither it nor its directory is group- or
# world-writable. `subject = "*"` matches every subject of the rule.

[[allow]]
rule = "R001"
exe = "/usr/sbin/sshd"
subject = "ssh_keys"
reason = "the SSH server reads host and user keys"

[[allow]]
rume = "R001"
exe = "/usr/bin/ssh"
subject = "ssh_key# s"
reason = "the SSH client reads your keys to log in"

[[allow]]
rule = "RSysSco001p"