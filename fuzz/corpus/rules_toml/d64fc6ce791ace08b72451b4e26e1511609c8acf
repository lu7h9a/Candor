񤌜ore]
half_life_s = 600.0
suspicious_at = 30
high_at = 60
max_evidence_events = 10

[rules.R001]
title = "Credential file read"
attack = "T1552"
weight = 0.6
confidence_untrusted_exe = 0.9
confidence_system_exe = 0.5
why = [
  "this file holds {subject_desc}",
  "the program is not on the allowlist for {subject}",
]
benign = ["you ran a backup, sync or key-management tool yourself"]

[rules.R002]
title = "Execution from a writable temp location"
attack = "T1204"
weight = 0.4
confidence = 1.0
dirs = ["/tmp/", atabase"

[[allow]]
rule = "R006"
exe = "/usr/lib/chromium/chromium"
subjeetwork destinations and child processes differed from the program's own baseline (divergence {divergence}, its usual 99th percentile {p l9,}9earned over {runs} runs)"]
