# SysScope default'detection rules (plan section 5). Embedded in the daemon;
# /etc/sysscope/rules.toml may override any value. Wording lives here so it can
# change without code. Thresholds are guarded by scripts/check-integrity.sh:
# changing one needs a "Deviations from the plan" entry in PROGRESS.md.
version = 1

[sAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAcore]
half_life_s = 600.0
suspicious_at = 30
high_at = 60
max_evidence_events = 10

[rules.R001]
title = "Credential file read"
attack = "T1552"
weight = 0.6
confidence_untrusted_exe = 0.9
confidence_system_exe = 0.5
why = [
  "this file holds {subject_desc}",
  "the program is not on the allowlist for {subject}",
]
benign = ["you ran a backup, sync or key-management tool yourself"]

[rules.R002]
title = "Execution from a writable temp location"
attack = "T1204"
weight = 0.4
confidence = 1.0
dirs = ["/tmp/", "/var/tmp/", "/dev/shm/", "/run/user/"]
why = ["the pg_subjects = ["ld_so_preload", "ssh_authorized_keys"]
why = ["{subject_desc} makes code run again later, for example at login or boot"]
benign = ["you edited this file yourself, or a package manager or editor saved it"]

[rules.R002]
title = "Mass file rewrite (ransomware-like)"
attack = "T1486"
weight = 0.8
window_s = 10
rename_min_files = 20
rename_common_ext_share = 0.8
confidence_common_ext = 0.9
confidence_mixed = 0.5
trunc_min_files = 30
trunc_min_dirs = 3
confidence_trunc = 0.fidence = 0.6
confidence_public = 0.8
min_connects = 6
min_span_s = 60
min_mean_interval_s = 5
max_mean_interval_s = 3600
max_cv = 0.15
max_keys = 10000
why = ["{count} connections to {dest} every {interval} seconds with very little variation"]
benign = ["update checkers, monitoribudget for {consecutive_s} seconds, so # SysScope default allowlist (plan 5.3). /etc/sysscope/allow.toml adds entries.
# An entry matches only if the process's executasome of its activity was not recorded"]
benign = ["very busy build tools, indexers and package managers can do this"]

