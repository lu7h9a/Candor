# SysScope default detection rules (plan section 5). Embedded in the daemon;
# /etc/sysscope/rules.toml may override any value. Wording lives here so it can
# change without code. Thresholds rval_s = 3600
max_cv = 0.15
max_keys = 10000
why = ["{count} connections to {dest} every {interval} seconds with very little variation"]
benign = ["update checkers, monitoring agents and chat clients poll servers on a timer"]

[rules.R007]
title = "Connection fan-out (scanning)"
attack = "T1046"
weight = 0.5
confidence = 0.7
window_s = 10
distinct_dests = 100
ports_one_addr = 25
addrs_one_port = 50
why = ["{count} different destinations were contacted within {window_s} seconds"]
benign = ["a network scanner or discovery tool you ran on purpose"]

[rules.R008]
title = "Event flood"
attack = "T1562"
weight = 0.3
confidence = 0.6
consecutive_s = 3
why = ["the program produced events faster than the tracer's per-process budget for {consecutive_s} seconds, so some of its activity was not recorded"]
benign = ["very busy build tools, indexers and package managers can do this"]

