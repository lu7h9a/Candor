# Maintainer: Candor <https://github.com/lu7h9a/candor>
# Built from the release tarball (packaging/build.sh writes pkgver and
# sha256sums). Plan WP30, D21: the service is installed, never enabled.
pkgname=candor
pkgver=@VERSION@
pkgrel=1
pkgdesc="Process monitor that explains what programs do (eBPF)"
arch=('x86_64')
url="https://github.com/lu7h9a/candor"
license=('MIT')
depends=('systemd' 'libelf' 'zlib' 'zstd')
optdepends=('bubblewrap: Glasshouse sandbox')
backup=('etc/candor/rules.toml' 'etc/candor/allow.toml' 'etc/candor/candord.toml')
install=candor.install
source=("candor-${pkgver}-x86_64.tar.gz")
sha256sums=('@SHA256@')
options=('!strip' '!debug')

package() {
    cp -a "${srcdir}/candor-${pkgver}-x86_64/root/." "${pkgdir}/"
}
