#!/bin/sh
# Remove: unit, socket dir and state dir go; /etc/candor stays.
# Purge: /etc/candor goes too (plan WP30). Groups and the sandbox user are
# left in place, as for any package (files they own are gone).
set -e
case "$1" in
remove|purge)
    rm -rf /run/candor /var/lib/candor
    systemctl daemon-reload >/dev/null 2>&1 || true
    ;;
esac
if [ "$1" = "purge" ]; then
    rm -rf /etc/candor
fi
exit 0
